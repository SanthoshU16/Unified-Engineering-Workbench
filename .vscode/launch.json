{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Unified Workbench (Windows x64)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/backend/Release/workbench_server.exe",
      "args": ["--port", "8080", "--web-root", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Unified Engineering Workbench",
      "console": "integratedTerminal"
    },
    {
      "name": "Launch Unified Workbench (macOS / Linux)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/backend/workbench_server",
      "args": ["--port", "8080", "--web-root", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Unified Engineering Workbench",
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Run Workbench Test Suite (CTest / Debug)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/backend/workbench_tests",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Unified Engineering Workbench",
      "console": "integratedTerminal"
    }
  ]
}

