{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Unified Engineering Workbench",
      "type": "shell",
      "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release",
      "problemMatcher": ["$gcc", "$clang"]
    },
    {
      "label": "Build Unified Engineering Workbench",
      "type": "shell",
      "command": "cmake --build build --config Release",
      "dependsOn": "Configure Unified Engineering Workbench",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc", "$clang"]
    },
    {
      "label": "Run CTest Suite",
      "type": "shell",
      "command": "ctest --test-dir build --output-on-failure",
      "dependsOn": "Build Unified Engineering Workbench",
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}

